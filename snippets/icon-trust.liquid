{%- comment -%}
  Renders one line-style trust/USP icon.
  Accepts: icon (string) - one of: shield, sun, award, truck, leaf, gem, lock, box, return
{%- endcomment -%}
{%- case icon -%}
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="4.5" y="11" width="15" height="9.5" rx="1"></rect>
      <path d="M7.5 11V7.5a4.5 4.5 0 0 1 9 0V11"></path>
    </svg>
  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.5 7.5 12 3l8.5 4.5V16.5L12 21l-8.5-4.5z"></path>
      <path d="M3.5 7.5 12 12l8.5-4.5"></path>
      <path d="M12 12v9"></path>
    </svg>
  {%- when 'return' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 12a8 8 0 1 0 2.6-5.9"></path>
      <path d="M4 3.5V7h3.5"></path>
    </svg>
  {%- when 'sun' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="4.5"></circle>
      <path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12h2.5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
    </svg>
  {%- when 'award' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.5" r="5.5"></circle>
      <path d="M8.3 13.2 7 21l5-2.6L17 21l-1.3-7.8"></path>
    </svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="1.5" y="7" width="13" height="9"></rect>
      <path d="M14.5 10h4l3.5 3.5V16h-7.5z"></path>
      <circle cx="6" cy="18.5" r="1.75"></circle>
      <circle cx="17.5" cy="18.5" r="1.75"></circle>
    </svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M20 4C10 4 4 10 4 18c0 .7 0 1.4.1 2 8.6-.4 14.5-4.4 15.9-16z"></path>
      <path d="M5 19 18 6"></path>
    </svg>
  {%- when 'gem' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M6 3h12l3.5 5.5L12 21 2.5 8.5z"></path>
      <path d="M2.5 8.5h19M9 3l-2.5 5.5L12 21l5.5-12.5L15 3"></path>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 2.5 20 6v6c0 5-3.4 8.4-8 9.5-4.6-1.1-8-4.5-8-9.5V6z"></path>
      <path d="m9 12 2 2 4-4.5"></path>
    </svg>
{%- endcase -%}
