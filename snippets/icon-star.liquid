{%- comment -%}
  Renders a 5-star rating row.
  Accepts: rating (whole number, 0-5)
{%- endcomment -%}
{%- liquid
  assign rating = rating | default: 5
  assign full_stars = rating | floor
-%}
<span class="rivage-stars" role="img" aria-label="{{ rating }}/5">
  {%- for i in (1..5) -%}
    {%- if i <= full_stars -%}
      <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.5l6.1-.7z"/></svg>
    {%- else -%}
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="0.75" aria-hidden="true" focusable="false"><path d="M10 1.2l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L1.3 7.5l6.1-.7z"/></svg>
    {%- endif -%}
  {%- endfor -%}
</span>
