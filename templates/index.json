{
  "sections": {
    "hero_3d": {
      "type": "hero-3d",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Maison Rivage",
            "heading_size": "hxxl"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p><em>Plus qu'une paire. Une signature.</em></p>",
            "text_style": "subtitle"
          }
        },
        "buttons": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Découvrir le modèle",
            "button_link_1": "shopify://collections/lunettes",
            "button_style_secondary_1": false,
            "button_label_2": "Voir la collection",
            "button_link_2": "shopify://collections/lunettes",
            "button_style_secondary_2": true
          }
        }
      },
      "block_order": ["heading", "text", "buttons"],
      "settings": {
        "product_image": "",
        "color_scheme": "scheme-3",
        "scrim_opacity": 35
      }
    },
    "featured_product": {
      "type": "featured-product",
      "blocks": {
        "text": {
          "type": "text",
          "settings": {
            "text": "Le modèle qui définit la Maison.",
            "text_style": "subtitle"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h0"
          }
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "swatch",
            "swatch_shape": "circle"
          }
        },
        "cta": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<a href=\"{{ product.url }}\" class=\"button button--primary\">Choisir ma couleur</a>"
          }
        }
      },
      "block_order": ["text", "title", "price", "variant_picker", "cta"],
      "settings": {
        "product": "",
        "color_scheme": "scheme-1",
        "secondary_background": false,
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "media_position": "left",
        "image_zoom": "hover",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 72,
        "padding_bottom": 72
      }
    },
    "featured_collection": {
      "type": "featured-collection",
      "settings": {
        "title": "La collection",
        "heading_size": "h1",
        "description": "",
        "show_description": false,
        "description_style": "body",
        "collection": "lunettes",
        "products_to_show": 5,
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "full_width": false,
        "show_view_all": true,
        "view_all_style": "link",
        "enable_desktop_slider": false,
        "swipe_on_mobile": true,
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "columns_mobile": "2",
        "padding_top": 64,
        "padding_bottom": 44
      }
    },
    "brand_story": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "L'univers Maison Rivage",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Inspirée par la lumière, les lignes du littoral et l'élégance méditerranéenne, Maison Rivage imagine des montures conçues pour traverser les saisons.</p>",
            "text_style": "body"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "Découvrir la Maison",
            "button_link": "shopify://pages/la-maison",
            "button_style_secondary": true
          }
        }
      },
      "block_order": ["caption", "text", "button"],
      "settings": {
        "height": "large",
        "desktop_image_width": "medium",
        "layout": "image_first",
        "image_behavior": "none",
        "content_layout": "no-overlap",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "color_scheme": "scheme-1",
        "mobile_content_alignment": "left",
        "padding_top": 80,
        "padding_bottom": 80
      }
    },
    "trust_badges": {
      "type": "trust-badges",
      "blocks": {
        "badge-1": {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "label": "Livraison suivie",
            "text": "Expédition sous 24-48h, suivi en temps réel"
          }
        },
        "badge-2": {
          "type": "badge",
          "settings": {
            "icon": "return",
            "label": "Retours simplifiés",
            "text": "30 jours pour changer d'avis"
          }
        },
        "badge-3": {
          "type": "badge",
          "settings": {
            "icon": "lock",
            "label": "Paiement sécurisé",
            "text": "Carte, Apple Pay, Shop Pay"
          }
        },
        "badge-4": {
          "type": "badge",
          "settings": {
            "icon": "box",
            "label": "Étui Maison Rivage inclus",
            "text": "Écrin rigide et chiffon microfibre"
          }
        }
      },
      "block_order": ["badge-1", "badge-2", "badge-3", "badge-4"],
      "settings": {
        "title": "",
        "color_scheme": "scheme-2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "newsletter": {
      "type": "newsletter",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Entrez dans l'univers Maison Rivage",
            "heading_size": "h1"
          }
        },
        "paragraph": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Découvrez les nouvelles montures, les campagnes et les prochaines éditions.</p>"
          }
        },
        "email_form": {
          "type": "email_form",
          "settings": {}
        }
      },
      "block_order": ["heading", "paragraph", "email_form"],
      "settings": {
        "color_scheme": "scheme-3",
        "full_width": true,
        "padding_top": 80,
        "padding_bottom": 90
      }
    }
  },
  "order": [
    "hero_3d",
    "featured_product",
    "featured_collection",
    "brand_story",
    "trust_badges",
    "newsletter"
  ]
}
