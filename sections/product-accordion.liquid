{%- comment -%}
  Product detail accordion driven by product metafields, with graceful
  fallback copy when a metafield hasn't been filled in yet. Renders
  identically to Dawn's native accordion component (collapsible-content).

  Expected metafields (namespace: custom):
  - dimensions          (single line text)
  - matieres            (single line text)
  - contenu_coffret     (list of single line text)
  - details_verres      (multi-line / rich text)
  - entretien           (multi-line / rich text)
{%- endcomment -%}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign details_text = product.metafields.custom.matieres.value | default: product.metafields.custom.matieres
  assign lens_text = product.metafields.custom.details_verres.value | default: product.metafields.custom.details_verres
  assign coffret = product.metafields.custom.contenu_coffret.value
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title inline-richtext h3">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="accordion">
      <details id="ProductAccordion-details-{{ section.id }}">
        <summary id="Summary-details-{{ section.id }}">
          {% render 'icon-accordion', icon: 'eye' %}
          <h3 class="accordion__title inline-richtext h4">Détails du produit</h3>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content rte" id="ProductAccordion-details-{{ section.id }}-content">
          {%- if details_text != blank or lens_text != blank -%}
            {%- if details_text != blank -%}<p>{{ details_text }}</p>{%- endif -%}
            {%- if lens_text != blank -%}<p>{{ lens_text }}</p>{%- endif -%}
          {%- else -%}
            <p>Monture façonnée à la main en acétate italien et titane, verres de qualité optique.</p>
          {%- endif -%}
        </div>
      </details>
    </div>

    <div class="accordion">
      <details id="ProductAccordion-dimensions-{{ section.id }}">
        <summary id="Summary-dimensions-{{ section.id }}">
          {% render 'icon-accordion', icon: 'ruler' %}
          <h3 class="accordion__title inline-richtext h4">Dimensions</h3>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content rte" id="ProductAccordion-dimensions-{{ section.id }}-content">
          {%- if product.metafields.custom.dimensions != blank -%}
            <p>{{ product.metafields.custom.dimensions.value | default: product.metafields.custom.dimensions }}</p>
          {%- else -%}
            <p>Dimensions précises disponibles prochainement.</p>
          {%- endif -%}
        </div>
      </details>
    </div>

    <div class="accordion">
      <details id="ProductAccordion-coffret-{{ section.id }}">
        <summary id="Summary-coffret-{{ section.id }}">
          {% render 'icon-accordion', icon: 'box' %}
          <h3 class="accordion__title inline-richtext h4">Contenu du coffret</h3>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content rte" id="ProductAccordion-coffret-{{ section.id }}-content">
          {%- if coffret != blank -%}
            <ul>
              {%- for item in coffret -%}
                <li>{{ item }}</li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p>Écrin rigide Maison Rivage, chiffon microfibre et certificat d'authenticité.</p>
          {%- endif -%}
        </div>
      </details>
    </div>

    <div class="accordion">
      <details id="ProductAccordion-entretien-{{ section.id }}">
        <summary id="Summary-entretien-{{ section.id }}">
          {% render 'icon-accordion', icon: 'washing' %}
          <h3 class="accordion__title inline-richtext h4">Entretien</h3>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content rte" id="ProductAccordion-entretien-{{ section.id }}-content">
          {%- if product.metafields.custom.entretien != blank -%}
            <p>{{ product.metafields.custom.entretien.value | default: product.metafields.custom.entretien }}</p>
          {%- else -%}
            <p>Nettoyez les verres avec le chiffon microfibre fourni. Évitez solvants et essuie-tout, rangez toujours la monture dans son étui.</p>
          {%- endif -%}
        </div>
      </details>
    </div>

    <div class="accordion">
      <details id="ProductAccordion-shipping-{{ section.id }}">
        <summary id="Summary-shipping-{{ section.id }}">
          {% render 'icon-accordion', icon: 'return' %}
          <h3 class="accordion__title inline-richtext h4">Retours &amp; livraison</h3>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </summary>
        <div class="accordion__content rte" id="ProductAccordion-shipping-{{ section.id }}-content">
          <p>Livraison offerte dès 100€ d'achat, expédition sous 24-48h. Retours gratuits sous 30 jours.</p>
        </div>
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Accordéon produit",
  "class": "section",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Détails du produit"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Marges de section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge haute",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge basse",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Accordéon produit"
    }
  ]
}
{% endschema %}
