{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .rivage-trust-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
  }

  @media screen and (min-width: 750px) {
    .rivage-trust-bar {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
      gap: 2rem;
    }
  }

  .rivage-trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
  }

  .rivage-trust-bar__icon {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
  }

  .rivage-trust-bar__icon svg {
    width: 100%;
    height: 100%;
  }

  .rivage-trust-bar__label {
    font-size: 1.3rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0;
  }

  .rivage-trust-bar__text {
    font-size: 1.3rem;
    opacity: 0.75;
    margin: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin center">
        <h2 class="title inline-richtext h3">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}
    <div class="rivage-trust-bar">
      {%- for block in section.blocks -%}
        <div class="rivage-trust-bar__item" {{ block.shopify_attributes }}>
          <span class="rivage-trust-bar__icon">{% render 'icon-trust', icon: block.settings.icon %}</span>
          {%- if block.settings.label != blank -%}
            <p class="rivage-trust-bar__label">{{ block.settings.label }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="rivage-trust-bar__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bandeau de confiance",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Titre",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Marges de section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge haute",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge basse",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "shield", "label": "Bouclier" },
            { "value": "sun", "label": "Soleil" },
            { "value": "award", "label": "Médaille" },
            { "value": "truck", "label": "Camion" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "gem", "label": "Gemme" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Protection UV400"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description courte",
          "default": "100% des rayons UVA/UVB filtrés"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau de confiance",
      "blocks": [
        {
          "type": "badge",
          "settings": { "icon": "sun", "label": "Protection UV400", "text": "100% des rayons UVA/UVB filtrés" }
        },
        {
          "type": "badge",
          "settings": { "icon": "gem", "label": "Verres polarisés", "text": "Anti-reflets, netteté absolue" }
        },
        {
          "type": "badge",
          "settings": { "icon": "award", "label": "Garantie 2 ans", "text": "Sur monture et charnières" }
        },
        {
          "type": "badge",
          "settings": { "icon": "truck", "label": "Livraison offerte", "text": "Dès 100€ d'achat" }
        }
      ]
    }
  ]
}
{% endschema %}
