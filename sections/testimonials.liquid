{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .rivage-testimonials {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: rgba(var(--color-foreground), 0.08);
    border: 1px solid rgba(var(--color-foreground), 0.08);
  }

  @media screen and (min-width: 750px) {
    .rivage-testimonials {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rivage-testimonial {
    background: rgb(var(--color-background));
    padding: 3.2rem 2.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .rivage-stars {
    display: inline-flex;
    gap: 0.2rem;
    color: currentColor;
  }

  .rivage-testimonial__quote {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: 1.9rem;
    line-height: 1.45;
    margin: 0;
    flex-grow: 1;
  }

  .rivage-testimonial__author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rivage-testimonial__name {
    font-size: 1.3rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .rivage-testimonial__meta {
    font-size: 1.2rem;
    opacity: 0.65;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin center">
        <h2 class="title inline-richtext h1">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}
    <div class="rivage-testimonials">
      {%- for block in section.blocks -%}
        <div class="rivage-testimonial" {{ block.shopify_attributes }}>
          {% render 'icon-star', rating: block.settings.rating %}
          {%- if block.settings.quote != blank -%}
            <p class="rivage-testimonial__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          {%- endif -%}
          <div class="rivage-testimonial__author">
            {%- if block.settings.name != blank -%}
              <span class="rivage-testimonial__name">{{ block.settings.name }}</span>
            {%- endif -%}
            {%- if block.settings.meta != blank -%}
              <span class="rivage-testimonial__meta">{{ block.settings.meta }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Avis clients",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Titre",
      "default": "Ce qu'ils en disent"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Marges de section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge haute",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Marge basse",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Citation",
          "default": "Une finition impeccable et un confort que je n'avais encore jamais trouvé sur une paire de lunettes de soleil."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Camille D."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Précision (ville, produit...)",
          "default": "Cliente vérifiée"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
